# ──────────────────────────────────────────────────────────────────────────────
# AI Assistant configuration ("Ask My Portfolio")
#
# Everything below is OPTIONAL. With no variables set, the site runs in
# "local demo mode": the API route answers from the structured profile data
# in data/profile.ts — no API key, no external calls, zero cost.
#
# To switch to a real LLM, set AI_PROVIDER and the matching API key.
# No code changes are needed.
# ──────────────────────────────────────────────────────────────────────────────

# Which provider to use: "local" (default) | "anthropic" | "openai"
AI_PROVIDER=local

# Anthropic — https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI — https://platform.openai.com
# OPENAI_API_KEY=sk-...
# Optional model override (defaults to gpt-4o)
# OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────────────────────

# Canonical URL, used for Open Graph / Twitter card metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
